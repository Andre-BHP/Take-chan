{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "sitio": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "server": "src/main.server.ts",
            "outputMode": "static",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "350kB",
                  "maximumError": "500kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "24kB",
                  "maximumError": "28kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "pages": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "350kB",
                  "maximumError": "500kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "24kB",
                  "maximumError": "28kB"
                }
              ],
              "outputHashing": "all",
              "baseHref": "/Take-chan/",
              "fileReplacements": [
                {
                  "replace": "src/entornos/entorno.ts",
                  "with": "src/entornos/entorno.pages.ts"
                }
              ],
              "outputPath": "dist/pages"
            },
            "oficial": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "350kB",
                  "maximumError": "500kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "24kB",
                  "maximumError": "28kB"
                }
              ],
              "outputHashing": "all",
              "baseHref": "/",
              "fileReplacements": [
                {
                  "replace": "src/entornos/entorno.ts",
                  "with": "src/entornos/entorno.oficial.ts"
                }
              ],
              "outputPath": "dist/oficial"
            },
            "prueba-oficial": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "350kB",
                  "maximumError": "500kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "24kB",
                  "maximumError": "28kB"
                }
              ],
              "outputHashing": "all",
              "baseHref": "/",
              "fileReplacements": [
                {
                  "replace": "src/entornos/entorno.ts",
                  "with": "src/entornos/entorno.prueba-oficial.ts"
                }
              ],
              "outputPath": "dist/prueba-oficial"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "sitio:build:production"
            },
            "development": {
              "buildTarget": "sitio:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
