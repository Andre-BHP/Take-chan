{
  "name": "sitio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:ssr:sitio": "node dist/sitio/server/server.mjs",
    "build:pages": "ng build -c pages && node scripts/preparar.mjs dist/pages/browser pages",
    "build:oficial": "ng build -c oficial && node scripts/preparar.mjs dist/oficial/browser oficial",
    "build:prueba-oficial": "ng build -c prueba-oficial && node scripts/preparar.mjs dist/prueba-oficial/browser prueba-oficial"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.6",
    "@angular/ssr": "^22.2.7",
    "express": "^5.1.0",
    "gsap": "3.13",
    "lenis": "1.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "typescript": "~6.0.2"
  }
}
